# CityFix API base URL (server side only; the browser talks to /api/proxy)
API_URL=https://cityfix-b7a6.netlify.app/api/v1

# Public URL of this frontend (metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: same value as the API's JWT_ACCESS_SECRET. When set, proxy.ts verifies the
# access-token signature before trusting its role claim; otherwise it only decodes it.
JWT_ACCESS_SECRET=
